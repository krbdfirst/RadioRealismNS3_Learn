#
# on windows, special care is needed for linking
# adapted from INET Framework (inet-4.2.2) makefrag
#
ifneq (,$(findstring win32,$(PLATFORM)))
  #
  # on windows we have to link with the ws2_32 (winsock2) library as it is no longer added
  # to the omnetpp system libraries by default (as of OMNeT++ 5.1)
  #
  LDFLAGS += -lws2_32
  DEFINES += -DVEINS_INET_EXPORT
  ENABLE_AUTO_IMPORT=-Wl,--enable-auto-import
  LDFLAGS := $(filter-out $(ENABLE_AUTO_IMPORT), $(LDFLAGS))

  # FIX for clang not exporting typeinfo and other thunks on Windows
  ifeq ($(CC),clang)
    DEFFILE = $O/typeinfo.def
    LDFLAGS += $(DEFFILE)

.PHONY: all

all:

$(DEFFILE): $(OBJS)  $(wildcard $(EXTRA_OBJS)) Makefile $(CONFIGFILE)
	$(Q)$(DLLTOOL) --export-all-symbols --kill-at --output-def $O/all.def $(OBJS) $(EXTRA_OBJS)
	$(Q)grep -E '( *_ZTI)|( *_ZThn)|( *_ZTv0)|EXPORTS' $O/all.def | sed 's/ @.*//' >$(DEFFILE)

$O/$(TARGET): $(DEFFILE)

  endif
endif

#
# macOS install_name_tool may need to grow load commands after linking.
# Reserve enough header space so relinking does not fail on Apple Silicon.
#
ifneq (,$(findstring macos,$(PLATFORM)))
  LDFLAGS += -Wl,-headerpad_max_install_names
endif


#
# Use the new message compiler introduced in OMNeT++ 5.3
#
MSGC:=$(MSGC) --msg6

# Fix INET include path: opp_makemake may record /src/debug/src which does not exist.
# Replace it with the real INET src directory. Safe to apply even if already correct.
INCLUDE_PATH := $(subst $(INET_PROJ)/src/debug/src,$(INET_PROJ)/src,$(INCLUDE_PATH))
MSGCOPTS    := $(subst $(INET_PROJ)/src/debug/src,$(INET_PROJ)/src,$(MSGCOPTS))
