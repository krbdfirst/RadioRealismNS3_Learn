+double TraCIDemo11p::computeTTC(double speed, double leaderSpeed, double gap)
+{
+    if (gap <= 0)              return 0.0;
+    double rel = speed - leaderSpeed;
+    if (rel <= 0)              return TTC_INFINITY;
+    return gap / rel;
+}
