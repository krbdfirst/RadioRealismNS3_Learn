# --- local configuration -----------------------------------------------------
# Machine-specific paths, set per installation.
env.local.sh

# --- simulation output -------------------------------------------------------
# Regenerated by the run scripts; roughly 30 GB for the full study.
# sample_results/ is tracked and is re-included below.
01_omnet_project/results/
01_omnet_project/ns3_mobility/
01_omnet_project/logs/
02_ns3_lena/**/results/
02_ns3_lena/**/inputs/
02_ns3_lena/**/logs/
*.sca
*.vec
*.vci
*.db
*.elog
.cmdenv-log

# Keep the sample results.
!01_omnet_project/sample_results/
!01_omnet_project/sample_results/**

# --- OMNeT++ / Veins build artifacts ----------------------------------------
# Makefiles are generated by ./configure and contain absolute paths, so they are
# not committed. makefrag is committed; it carries the build fixes.
# Veins itself is not in this repository (see 03_veins/README.md); its build
# products live in $VEINS_ROOT. Kept in case a Veins tree is unpacked here.
03_veins/**/Makefile
03_veins/**/Makefile.bak
out/
**/out/
*.o
*.d
*_m.cc
*_m.h
*.so
*.dylib
*.dll
*.a

# --- ns-3 build --------------------------------------------------------------
build/
cmake-cache/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- MATLAB ------------------------------------------------------------------
*.asv
*.mat
slprj/

# --- editors / OS ------------------------------------------------------------
.DS_Store
*Zone.Identifier
.vscode/
.idea/
*.swp
*~

